# 依赖
node_modules/

# npm 缓存（本机安装缓存，可再生，勿提交）
.npm-cache/

# secrets —— 永不提交（本地 .env 自行维护，模板见 .env.example）
.env
.env.*
!.env.example

# 抓取原始数据（本地留存，不进仓库；结论已沉淀进 notes/）
jd-research/

# demo 运行产物（可再生）
# 注意：必须是「文件级」harness-demo/trajectories/* 而不能写 trajectories/ ——
# 目录级排除会让 git 根本不 descend 进该目录，下面的 negation 永不生效
# （已实测：`sub/` + `!sub/keep.jsonl` 仍忽略 keep.jsonl；`sub/*` + negation 才放行）。
harness-demo/trajectories/*
!harness-demo/trajectories/demo.example.jsonl
harness-demo/workspace/out/
durable-execution-demo/.state/

# 站点结构+几何回归的本地运行产物（截图/report，可再生；CI 侧以 artifact 为准）
site/tools/out/

*.log

# AgentTeams 运行时状态（团队会话数据，勿提交）
.agent-teams/
