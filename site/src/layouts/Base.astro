---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'learn-agent-harness —— coding agent 工程师方向的五阶段课程体系：17 课 · P0–P4 线性路线 · 每课带可运行参考样本 · 增量主线 my-agent · 知识地图与面试题库。本站为构建时快照。',
} = Astro.props;
const pageTitle = title ? `${title} · learn-agent-harness` : 'learn-agent-harness · coding agent 五阶段课程体系';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* C2/PRES-F3：canonical + 最小 og/twitter 组。
        canonical = Astro.site（含 base 的绝对前缀，带尾斜杠）+ 当前 pathname；
        `new URL('/learn-agent-harness/map/', 'https://blog.zero43.top/learn-agent-harness/')`
        会解析成 https://blog.zero43.top/learn-agent-harness/map/，正是想要的绝对地址。 */}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="learn-agent-harness" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.svg"} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      // 首屏前定主题，避免闪烁
      (function () {
        try {
          var t = localStorage.getItem('lah-theme');
          if (t !== 'light' && t !== 'dark') {
            t =
              window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    {/* P-11 skip-link：键盘第一个 Tab 聚焦时滑入视口，回车跳主内容。
        纯 CSS :focus 生效（无 JS 可用）；视觉隐藏用负 top（不用 display:none，
        那样不可聚焦）。位置在阅读进度条之前——它是全页第一个可聚焦元素。 */}
    <a class="skip-link" href="#main">跳到主内容</a>
    {/* P-08 阅读进度条：2px，随滚动填充。默认 hidden——无 JS 时整条不渲染
        （不给屏幕阅读器留一个永远 0% 的假 progressbar）；脚本启动时才启用。 */}
    <div
      class="reading-progress"
      data-reading-progress
      role="progressbar"
      aria-label="阅读进度"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      hidden
    >
    </div>
    <Header />
    <main class="wrap" id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // 主题切换
      const btn = document.querySelector('[data-theme-toggle]');
      if (btn) {
        btn.addEventListener('click', () => {
          const next =
            document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('lah-theme', next);
          } catch (e) {}
          document.dispatchEvent(new CustomEvent('lah:theme-change'));
        });
      }
      // mermaid：仅当页面有图时才加载 bundle
      if (document.querySelector('.mermaid')) {
        import('../scripts/mermaid.ts').then((m) => m.renderAllMermaid());
      }

      // P-08 阅读进度条（纯函数进度算法抽出来便于 node 等效验证，见交付说明）
      export function readingProgressPct(
        scrollTop: number,
        scrollHeight: number,
        clientHeight: number,
      ): number {
        const max = scrollHeight - clientHeight;
        if (max <= 0) return 0; // 无可滚动内容（短页）恒 0
        return Math.min(100, Math.max(0, (scrollTop / max) * 100));
      }

      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
      if (progress) {
        progress.hidden = false;
        let raf = 0;
        const update = () => {
          raf = 0;
          const root = document.documentElement;
          const pct = readingProgressPct(root.scrollTop, root.scrollHeight, root.clientHeight);
          progress.style.setProperty('--reading-progress', pct.toFixed(2) + '%');
          progress.setAttribute('aria-valuenow', String(Math.round(pct)));
        };
        // prefers-reduced-motion：不做 rAF 合帧——滚动事件直接同步更新，
        // 瞬时到位无插值感（CSS 侧的 width 过渡也已在 reduce 下禁用）。
        const reduceMotion =
          (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) ?? false;
        const schedule = () => {
          if (reduceMotion) update();
          else if (!raf) raf = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule, { passive: true });
        update();
      }

      // P-07/P-08/P-10 共用的布局锚：--header-offset 同步为小顶栏实测高度。
      // 消费方：汉堡浮层 top:100% 之外的 sticky 贴靠（works 标签栏）、
      // h2/h3 与 .work 的 scroll-margin-top（锚点跳转不被顶栏遮挡）。
      // 无 JS 时用 CSS 兜底值 76px（站内 scroll-margin 既有约定），功能不破。
      const headerEl = document.querySelector('.site-header');
      if (headerEl) {
        const syncHeaderOffset = () =>
          document.documentElement.style.setProperty('--header-offset', `${headerEl.offsetHeight}px`);
        syncHeaderOffset();
        window.addEventListener('resize', syncHeaderOffset, { passive: true });
      }
    </script>
  </body>
</html>
