---
/**
 * /interview：面试演练库（复习主页）。
 * 顶部复习主区：复习动线 3 步 + 5 大考点分组 top 15 题 + "只有 30 分钟"快速链接。
 * 选题全部来自 notes/interview-bank.md 真实题目（§3 项目深挖 / §4 交叉快速问答 / §8 行为面），
 * 题号（§x·Qy）可回溯到下方全文；锚点 id 与站点 TOC 同算法（github-slugger 兼容）。
 * 下方：interview-bank.md 原样渲染（保持不动）。导航"题库"。
 */
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { extractToc } from '../utils/toc';

const entries = await getCollection('courses');
const entry = entries.find((e) => e.id === 'interview-bank');
const rendered = entry ? await render(entry) : null;
const base = import.meta.env.BASE_URL;

/** 锚点：从题库正文定位章节标题 id（与 c/[slug] 页 TOC 锚点同一套 slug 算法） */
const toc = entry ? extractToc(entry.body ?? '') : [];
function idOf(prefix: string): string {
  const hit = toc.find((t) => t.text.startsWith(prefix));
  if (!hit) {
    throw new Error(`interview.astro：复习主区锚点找不到章节 "${prefix}"——notes/interview-bank.md 章节变动后需同步`);
  }
  return hit.id;
}

interface QCard { num: string; q: string; hint: string; anchor: string }
interface Group { title: string; chip: string; qs: QCard[] }

const GROUPS: Group[] = entry
  ? [
      {
        title: '幽灵事故 · 权限 / 沙箱 / 事故响应',
        chip: '§3.1 · 最稀缺故事，5 题取 3',
        qs: [
          { num: '§3.1·Q1', q: '事故完整时间线？18:00-18:25 之间你做了什么？', hint: '25 分钟恢复、零数据丢失：先判范围，再恢复、防再发', anchor: idOf('3.1 FinHot 幽灵事故') },
          { num: '§3.1·Q2', q: '为什么并行会话能碰到生产？目录/容器/命名空间各缺了什么边界？', hint: '「谁在调」和「在哪执行」各一道门——一道门防不住两类威胁', anchor: idOf('3.1 FinHot 幽灵事故') },
          { num: '§3.1·Q4', q: '如果重做一次，架构上怎么让这类事故不可能发生？', hint: '沙箱池 / compose 项目隔离 / worktree——让边界不可绕过', anchor: idOf('3.1 FinHot 幽灵事故') },
        ],
      },
      {
        title: '评测与长任务 · FinHot labeler + backfill',
        chip: '§3.2 / §3.3 · 10 题取 3',
        qs: [
          { num: '§3.2·Q1', q: '为什么 T+5 而不是 T+1？', hint: '金融数据噪声 + 交易日历——延迟奖励要更长判定窗口', anchor: idOf('3.2 FinHot labeler') },
          { num: '§3.2·Q5', q: '这个系统和 SWE-bench 式评测的本质区别？', hint: '延迟奖励、真实世界结果——不是即时可验证', anchor: idOf('3.2 FinHot labeler') },
          { num: '§3.3·Q2', q: '断点续跑怎么实现的？幂等键是什么？', hint: '幂等键 + upsert——重跑不重、不漏', anchor: idOf('3.3 backfill') },
        ],
      },
      {
        title: '白板与检索实操 · harness-demo + rag-demo',
        chip: '§3.4 / §3.5 · 8 题取 3',
        qs: [
          { num: '§3.4·Q1', q: '四种运行模式各证明了什么？crash 模式怎么注入的？', hint: 'intent 先记 / 默认 deny / 结果必回写——三个关键设计', anchor: idOf('3.4 harness-demo') },
          { num: '§3.5·Q1', q: '为什么用 hash embedding 不用语义模型？', hint: '代理 503 不可用；可复现、可打印，局限写进复盘', anchor: idOf('3.5 rag-demo') },
          { num: '§3.5·Q2', q: 'recall@5 唯一漏题错在哪？', hint: 'paraphrase 探针 = 词法路的极限，跨不过语义改写', anchor: idOf('3.5 rag-demo') },
        ],
      },
      {
        title: '交叉快速问答 · 知识是否成网',
        chip: '§4 · 10 题取 3',
        qs: [
          { num: '§4·Q1', q: '提示注入攻击一个接了 MCP 的 coding agent，画出从 payload 进入到最后动作被（没）拦住的完整路径，标出每层防线', hint: '逐层画路径、标每道防线，说清哪层拦住了', anchor: idOf('4. 交叉快速问答') },
          { num: '§4·Q3', q: '上下文压缩、prompt caching、长期记忆注入，三者在"进 system 的 token"上怎么抢预算？', hint: '三者抢同一份 token 预算——先讲清先后与成本', anchor: idOf('4. 交叉快速问答') },
          { num: '§4·Q10', q: '"能用 workflow 不用 agent"——FinHot 的流水线是 agent 还是 workflow？哪里必须有模型自决？', hint: '流水线主体是 workflow，自决点必须留给模型', anchor: idOf('4. 交叉快速问答') },
        ],
      },
      {
        title: '行为面试 · 可预测的处事方式',
        chip: '§8 · 5 题取 3',
        qs: [
          { num: '§8·Q1', q: '你克服过的最大挑战', hint: '幽灵事故 S-T-A-R-L：25 分钟 / 零数据丢失，以规则收尾', anchor: idOf('8. 行为面试') },
          { num: '§8·Q2', q: '你的一次失败', hint: '承认一开始没发现；失败故事必须以机制收尾', anchor: idOf('8. 行为面试') },
          { num: '§8·Q4', q: '为什么做 agent 开发 / 为什么这个方向？', hint: '能写 / 能上生产 / 能从事故长机制——每句带 3 分钟故事', anchor: idOf('8. 行为面试') },
        ],
      },
    ]
  : [];
---

<Base title="面试题库">
  {
    rendered ? (
      <article class="markdown">
        <header class="course-meta-bar">
          <div class="meta-row">
            <span class="chip chip-strong">面试演练库</span>
            <span class="chip">结构 + 交叉题库 + JD 覆盖矩阵</span>
          </div>
          <nav class="crumbs" aria-label="面包屑">
            <a href={base}>首页</a> / <span>面试题库</span>
          </nav>
        </header>

        {
          GROUPS.length > 0 && (
            <section class="review-zone" aria-label="复习主区">
              <div class="review-head">
                <h2>复习主区</h2>
                <span class="chip chip-strong">top 15 题</span>
                <span class="review-head-note">先考点、后全文：3 步动线 · 5 大考点分组 · 30 分钟快速链接</span>
              </div>

              <div class="review-block">
                <h3 class="review-sec"><span class="dc-letter">①</span>复习动线（3 步）</h3>
                <div class="pipeline">
                  <a class="pipe-step" href={base + 'works/'}>
                    <b>第 1 步 · 作品</b>
                    /works/ 看 5 个作品——120 秒建立整体印象
                  </a>
                  <span class="pipe-arrow" aria-hidden="true">→</span>
                  <a class="pipe-step" href={base + 'learn/'}>
                    <b>第 2 步 · 课程</b>
                    /learn/ 按 18 课过一遍（正文带面试视角批注）
                  </a>
                  <span class="pipe-arrow" aria-hidden="true">→</span>
                  <div class="pipe-step">
                    <b>第 3 步 · 题库</b>
                    本页题库按考点查漏（下方全文）
                  </div>
                </div>
              </div>

              <div class="review-block">
                <h3 class="review-sec">
                  <span class="dc-letter">②</span>5 大考点分组 · top 15 题
                  <span class="sec-note">题号可回溯下方全文；答题要点从题库答案提炼（≤30 字）</span>
                </h3>
                {
                  GROUPS.map((g) => (
                    <div class="review-group">
                      <h4 class="review-group-title">
                        {g.title}
                        <span class="chip">{g.chip}</span>
                      </h4>
                      <div class="cards">
                        {
                          g.qs.map((q) => (
                            <div class="card q-card">
                              <span class="q-num">{q.num}</span>
                              <p class="q-text">{q.q}</p>
                              <p class="q-hint">要点：{q.hint}</p>
                              <a class="q-foot" href={`#${q.anchor}`}>在下方全文中查看 →</a>
                            </div>
                          ))
                        }
                      </div>
                    </div>
                  ))
                }
              </div>

              <div class="review-block">
                <h3 class="review-sec">
                  <span class="dc-letter">③</span>只有 30 分钟？
                  <span class="sec-note">各一句"30 分钟能带走什么"</span>
                </h3>
                <div class="cards">
                  <a class="card" href={base + 'details/'}>
                    <h3>8 个分水岭细节</h3>
                    <p>每个 1 分钟：资深与新手之间的 8 道"坑"，看完能说清每道为什么是分水岭。</p>
                  </a>
                  <a class="card" href={base + 'c/multi-agent/'}>
                    <h3>多智能体编排</h3>
                    <p>"读多路、写单线程"——一页判定该不该拆子代理，附给 harness-demo 设计子代理的练习。</p>
                  </a>
                  <a class="card" href={base + 'timeline/'}>
                    <h3>LLM 时间线</h3>
                    <p>12 个演化节点：为什么当年这么设计、下一步往哪走——面试谈资备用。</p>
                  </a>
                </div>
              </div>
            </section>
          )
        }

        <rendered.Content />
        <p style="margin-top: 28px; color: var(--text-faint); font-size: 0.9rem">
          各课内部题库在课程文件末尾（<a href={base + 'learn/'}>学习路线 →</a>），本页面管结构、交叉题、项目深挖、关键词覆盖。
        </p>
      </article>
    ) : (
      <div class="empty-state">
        <p class="empty-icon">🚧</p>
        <h1>面试题库</h1>
        <p><code>notes/interview-bank.md</code> 未就位——文件入仓后随下一次构建自动渲染。</p>
      </div>
    )
  }
</Base>
