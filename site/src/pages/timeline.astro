---
/**
 * /timeline：LLM 时间线（notes/llm-timeline.md）。
 * 并行 worker 正在撰写——文件未就位时显示“撰写中”占位，build 不报错。
 * （llm-timeline 同时在 /c/llm-timeline 作为课程页出现，若已就位。）
 */
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getCollection, render } from 'astro:content';
import { courseMeta } from '../data/courses';

const entries = await getCollection('courses');
const entry = entries.find((e) => e.id === 'llm-timeline');
const rendered = entry ? await render(entry) : null;
const meta = courseMeta('llm-timeline');
---

<Base title="LLM 时间线">
  {
    rendered ? (
      <article class="markdown">
        <header class="course-meta-bar">
          <div class="meta-row">
            <span class="chip chip-strong">{meta.domain}</span>
            <span class="chip">{meta.phase}</span>
            <StatusBadge status={meta.status} />
          </div>
          <nav class="crumbs" aria-label="面包屑">
            <a href="/">首页</a> / <span>LLM 时间线</span>
          </nav>
        </header>
        <rendered.Content />
      </article>
    ) : (
      <div class="empty-state">
        <p class="empty-icon">🚧</p>
        <h1>LLM 时间线</h1>
        <p style="max-width: 34em; margin: 12px auto">
          <strong>撰写中</strong> —— <code>notes/llm-timeline.md</code>
          尚未就位（并行内容 worker 正在写）。文件入仓后，本站下一次构建会自动渲染全文。
        </p>
        <p style="max-width: 34em; margin: 0 auto">
          先看其他课程的进度：<a href="/learn/">学习路线 →</a>
        </p>
      </div>
    )
  }
</Base>
