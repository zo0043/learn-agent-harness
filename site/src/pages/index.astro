---
/**
 * 首页信息架构（第一性原理重排，2026-10-14）：
 *
 * 旧版把首页当作「学习成果陈列柜」——先铺 6 个作品、3 起事故，读者要翻到页尾
 * 才知道这是个 17 课的五阶段体系。新版按「读者来干什么」排序：
 *   ① 这里能学到什么（五阶段路线一屏可见，可点进任一阶段）
 *   ② 怎么学（增量主线：自己搭 vs 参考答案）
 *   ③ 学完能干什么（作品/题库/详解 = 横向纵深）
 *   ④ 数据（进度总览，降到页尾）
 * 作品与事故不再是主角，而是「路线走完后的纵深材料」。
 */
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { COURSE_COUNT, DOMAIN_COUNT, WORK_COUNT } from '../data/courses';
import {
  COURSE_STRUCTURE,
  STAGES,
  STAGE_LABELS,
  STAGE_COUNTS,
  STAGE_DESC,
} from '../data/course-structure';
import { MILESTONES } from '../data/capstone';
import { parseRagStats } from '../utils/ragStats';

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/zo0043/learn-agent-harness';

// rag-demo 评测数字构建期从 notes/rag.md §13 解析（唯一真源），解析失败即构建失败、不静默回退。
const ragEntry = (await getCollection('courses')).find((e) => e.id === 'rag');
const rag = parseRagStats(ragEntry?.body ?? '');

// 题目计数口径见 notes/knowledge-map.md 头部「计数口径」块（课内嵌 205 + 面试题库精选 37）。
const DETAIL_COUNT = (await getCollection('details')).length;
const Q_IN_LESSON = 205;
const Q_BANK = 37;

/** 各阶段首课（读者点进就能立刻开始，不用先回 /learn/ 找）。 */
const bySlug = new Map(COURSE_STRUCTURE.map((c) => [c.slug, c]));
const stageFirst = (stage: string) => COURSE_STRUCTURE.find((c) => c.stage === stage);
const stageCourses = (stage: string) => COURSE_STRUCTURE.filter((c) => c.stage === stage);

const mDone = MILESTONES.filter((m) => m.status === 'done').length;
---

<Base>
  <!-- ① 定位 + 路线一屏可见 ─────────────────────────────────── -->
  <section class="hero">
    <p class="hero-kicker">coding agent 工程师 · 五阶段课程体系 · 每课带可运行参考样本</p>
    <h1>从 0 到能写 agent 工具</h1>
    <p class="hero-sub">
      <strong>{COURSE_COUNT} 课 · 五个阶段 · {DOMAIN_COUNT} 个知识域</strong>，每门课都带
      <strong>可运行的参考样本</strong>（clone 下来就能跑，全离线零 key）。课程之外还有一条
      <strong>增量主线</strong>：跟着 {MILESTONES.length} 个里程碑，亲手搭出你自己的 agent 工具——
      每个里程碑的参考答案，就是前面那门课的 demo。
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={base + 'learn/'}>查看五阶段路线 →</a>
      <a class="btn" href={base + 'c/harness-from-scratch/'}>从第一课开始</a>
      <a class="btn" href={repo} target="_blank" rel="noopener">GitHub 仓库 ↗</a>
    </div>
  </section>

  <!-- 五阶段路线（核心：一屏看清学什么、每段几门课、从哪开始） -->
  <section class="route-section">
    <div class="route-head">
      <h2 class="page-title">五阶段路线</h2>
      <p class="page-lead">
        线性阅读序，每课都声明前置；点任一阶段直达该段课程。完整的依赖图见
        <a href={base + 'map/'}>知识地图 →</a>
      </p>
    </div>
    <div class="route-grid">
      {
        STAGES.map((stage, i) => {
          const first = stageFirst(stage);
          const courses = stageCourses(stage);
          return (
            <div class="route-card">
              <div class="route-top">
                <span class="route-stage">{stage}</span>
                <span class="route-label">{STAGE_LABELS[stage]}</span>
                <span class="route-count">{STAGE_COUNTS[stage]} 门课</span>
              </div>
              <p class="route-desc">{STAGE_DESC[stage]}</p>
              <ul class="route-list">
                {courses.map((c) => (
                  <li>
                    <a href={base + 'c/' + c.slug + '/'}>{bySlug.get(c.slug)?.domain ?? c.slug}</a>
                  </li>
                ))}
              </ul>
              {first && (
                <p class="route-start">
                  <a href={base + 'c/' + first.slug + '/'}>
                    从{first.isHorizontal ? '这一篇' : '这一课'}开始 →
                  </a>
                </p>
              )}
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- ② 增量主线：怎么学（自己搭 vs 参考答案） -->
  <section class="route-section">
    <div class="route-head">
      <h2 class="page-title">增量主线：亲手搭一个 agent</h2>
      <p class="page-lead">
        {MILESTONES.length} 个里程碑对应五个阶段，后段复用你亲手写的前段代码——
        不是读完 17 门课的参考样本就结束，而是<strong>你自己写的代码能跑起来</strong>。
        {mDone === MILESTONES.length
          ? `当前 ${MILESTONES.length} 个里程碑全部就位，仓库根目录 my-agent/ 可直接 clone。`
          : `当前 ${mDone}/${MILESTONES.length} 个里程碑就位。`}
      </p>
    </div>
    <ol class="ms-track">
      {
        MILESTONES.map((m) => (
          <li class="ms-item" data-milestone={m.key}>
            <span class="ms-name">{m.name}</span>
            <span class="chip">{m.stage}</span>
          </li>
        ))
      }
    </ol>
    <p class="route-more">
      <a class="btn btn-primary" href={base + 'learn/#capstone'}>看主线蓝图与过关判据 →</a>
    </p>
  </section>

  <!-- ③ 纵深材料：作品 / 题库 / 详解（路线之外，按需取用） -->
  <section class="route-section">
    <div class="route-head">
      <h2 class="page-title">课程之外的三类纵深</h2>
      <p class="page-lead">
        路线走完后按需取用——作品是参考样本的完整形态，题库是检验，详解是资深判断。
      </p>
    </div>

    <!-- 3a. 作品：与课程一一对应的参考样本 -->
    <div class="depth-block">
      <div class="depth-head">
        <h3>{WORK_COUNT} 个可运行作品</h3>
        <p>
          每个作品对应一门课，clone 下来即可跑（全离线零 key、逐字节可复现）。
          完整详解见 <a href={base + 'works/'}>作品页 →</a>
        </p>
      </div>
      <div class="cards">
        <a class="card depth-card" href={base + 'works/#harness-demo'}>
          <h4>harness-demo</h4>
          <p><span class="chip chip-strong">从零写 harness</span></p>
          <p>
            最小 agent harness：loop / 工具协议 / SSE 流式 / 权限门（默认 deny）/
            JSONL 轨迹 + 崩溃恢复 / token 压缩（1378→426 tok）。
          </p>
        </a>
        <a class="card depth-card" href={base + 'works/#rag-demo'}>
          <h4>rag-demo</h4>
          <p><span class="chip chip-strong">RAG 与检索</span></p>
          <p>
            零依赖 RAG：chunking → hash embedding → 暴力余弦 ∥ BM25 → RRF 融合 → 强制引用 →
            golden set 评测（{rag.chunks} chunks，recall@3={rag.recall3}，PASS {rag.pass}）。
          </p>
        </a>
        <a class="card depth-card" href={base + 'works/#sandbox-demo'}>
          <h4>sandbox-demo</h4>
          <p><span class="chip chip-strong">沙箱与凭据</span></p>
          <p>
            四通道 policy 引擎（deny &gt; approve &gt; sandbox &gt; allow）+ 幽灵事故重放，
            3 次重放逐字节一致。
          </p>
        </a>
        <a class="card depth-card" href={base + 'works/#mcp-demo'}>
          <h4>mcp-demo</h4>
          <p><span class="chip chip-strong">MCP 与供应链安全</span></p>
          <p>MCP 供应链投毒演示：mock server 注入 → 模型被劫持 → 四层防御拦截，单层消融 + 确定性重放。</p>
        </a>
        <a class="card depth-card" href={base + 'works/#durable-execution-demo'}>
          <h4>durable-execution-demo</h4>
          <p><span class="chip chip-strong">durable execution</span></p>
          <p>
            journal 双锚点 + checkpoint 原子写；3 种崩溃点真实 SIGKILL，恢复按判定表 replay / skip /
            unknown→confirm，副作用计数恒=1。
          </p>
        </a>
        <a class="card depth-card" href={base + 'works/#framework-demo'}>
          <h4>framework-demo</h4>
          <p><span class="chip chip-strong">框架生态</span></p>
          <p>Claude Agent SDK 四能力跑通：「框架给你什么 / 藏什么」的活样本。</p>
        </a>
      </div>
      <p class="depth-foot">
        <a href={base + 'works/#whiteboard'}>whiteboard/</a>：180 行 Python 面试口述版 · 全部作品见
        <a href={base + 'works/'}>作品页 →</a>
      </p>
    </div>

    <!-- 3b. 题库 -->
    <div class="depth-block">
      <div class="depth-head">
        <h3>题库：{Q_IN_LESSON} 题课内嵌 + {Q_BANK} 题精选</h3>
        <p>课内嵌练习题随课出现；面试题库精选按知识域组织，可当模拟考卷用。</p>
      </div>
      <p class="route-more">
        <a class="btn" href={base + 'interview/'}>进题库 →</a>
      </p>
    </div>

    <!-- 3c. 详解 -->
    <div class="depth-block">
      <div class="depth-head">
        <h3>详解：{DETAIL_COUNT} 个资深分水岭</h3>
        <p>
          每个带<strong>行业一手源</strong> + <strong>本地映射</strong>（已覆盖 / 未覆盖）——
          面试答到机制层时直接用的素材。
        </p>
      </div>
      <div class="details-entry-links">
        <a href={base + 'details/01-context-rot/'}>context rot：窗口大不等于能全塞</a>
        <a href={base + 'details/02-tool-granularity/'}>工具粒度：工具定义就是契约</a>
        <a href={base + 'details/07-harness-rot/'}>harness 假设会腐烂：为尚不存在的模型写稳定接口</a>
      </div>
      <p class="route-more">
        <a class="btn" href={base + 'details/'}>查看全部 {DETAIL_COUNT} 篇 →</a>
      </p>
    </div>
  </section>

  <!-- ④ 站内导航（横向知识：时间线 / 知识地图） -->
  <section class="route-section">
    <div class="route-head">
      <h2 class="page-title">横向知识</h2>
      <p class="page-lead">不挂在任一阶段上，但读课时随时会用到。</p>
    </div>
    <div class="cards">
      <a class="card depth-card" href={base + 'nav/'}>
        <h4>LLM 发展史与演进</h4>
        <p>
          {COURSE_STRUCTURE.find((c) => c.slug === 'llm-timeline')?.intro ?? ''}
        </p>
      </a>
      <a class="card depth-card" href={base + 'map/'}>
        <h4>知识地图</h4>
        <p>按知识域与阶段铺开全部课程，看清课程之间的依赖与被依赖关系。</p>
      </a>
    </div>
  </section>

  <!-- ⑤ 进度总览（降到页尾：想了解规模时才看） -->
  <section class="route-section">
    <h2 class="page-title">进度总览</h2>
    <div class="stats">
      <div class="stat">
        <span class="stat-num">{COURSE_COUNT}</span>
        <span class="stat-label">课程页</span>
      </div>
      <div class="stat">
        <span class="stat-num">{DOMAIN_COUNT}</span>
        <span class="stat-label">知识域</span>
      </div>
      <div class="stat">
        <span class="stat-num">{WORK_COUNT}</span>
        <span class="stat-label">可运行作品</span>
      </div>
      <div class="stat">
        <span class="stat-num">{Q_IN_LESSON}</span>
        <span class="stat-label">课内嵌练习题</span>
      </div>
      <div class="stat">
        <span class="stat-num">{Q_BANK}</span>
        <span class="stat-label">面试题库精选</span>
      </div>
    </div>
    <p class="tight">
      学习路线：<a href={base + 'learn/'}>P0–P4 五阶段 × {COURSE_COUNT} 课线性阅读序 →</a> ·
      知识依赖：<a href={base + 'map/'}>知识地图 →</a> ·
      模拟考卷：<a href={base + 'interview/'}>面试题库 →</a>
    </p>
    <p class="snap-note">
      📸 <strong>本站为构建时快照</strong>——内容由 Astro 在构建期从仓库 <code>notes/</code>
      渲染，不实时更新；仓库更新后随下一次构建（GitHub Actions）生效。
    </p>
  </section>
</Base>

<style>
  /* 首页专属：路线网格与纵深分块（其余复用 global.css 的 .card/.chip/.stats/.btn） */
  .route-section {
    margin-top: 42px;
  }
  .route-head .page-title {
    margin-bottom: 6px;
  }

  /* 五阶段路线：窄屏单列；宽屏固定 5 列一排（5 个阶段正好一行，避免 4+1 落单） */
  .route-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 16px;
  }
  @media (min-width: 640px) {
    .route-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .route-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .route-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 18px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .route-top {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }
  .route-stage {
    font-weight: 700;
    color: var(--accent);
    font-size: 1.02rem;
  }
  .route-label {
    font-weight: 600;
    font-size: 0.92rem;
  }
  .route-count {
    width: 100%;
    font-size: 0.8rem;
    color: var(--text-soft);
  }
  .route-desc {
    margin: 0;
    font-size: 0.84rem;
    color: var(--text-soft);
  }
  .route-list {
    margin: 4px 0 0;
    padding-left: 16px;
    font-size: 0.86rem;
    line-height: 1.65;
  }
  .route-start {
    margin: 4px 0 0;
    font-size: 0.84rem;
  }

  /* 主线里程碑轨道：横向序号，窄屏换行 */
  .ms-track {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ms-item {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 14px;
    font-size: 0.9rem;
  }
  .ms-name {
    font-weight: 600;
  }

  /* 纵深材料分块 */
  .depth-block {
    margin-top: 24px;
  }
  .depth-head h3 {
    margin: 0 0 4px;
    font-size: 1.1rem;
  }
  .depth-head p {
    margin: 0 0 12px;
    color: var(--text-soft);
    font-size: 0.92rem;
  }
  .depth-card h4 {
    margin: 0;
    font-size: 1.02rem;
  }
  .depth-card p {
    margin: 0;
    font-size: 0.9rem;
  }
  .depth-foot,
  .route-more {
    margin: 12px 0 0;
    font-size: 0.9rem;
  }
  .tight {
    margin-top: 10px;
  }
</style>
