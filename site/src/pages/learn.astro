---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getCollection } from 'astro:content';
import { COURSES, CARD_COUNT, COURSE_COUNT, DOMAIN_COUNT, STATUS_COUNTS, type CourseMeta } from '../data/courses';

const entries = await getCollection('courses');
const slugSet = new Set(entries.map((e) => e.id));

// 总进度全部取自 courses.ts 派生量（口径块见 notes/knowledge-map.md 头部「计数口径」：
// 课程卡 18 = 全部条目含 whiteboard 白板卡；知识域 15 = 14 编号课 + Harness 架构主线）。
const { done, doing, planned } = STATUS_COUNTS;

const PHASES: { phase: CourseMeta['phase']; desc: string }[] = [
  { phase: 'P0', desc: '核心段：白板 / 系统设计 / 项目深挖的硬通货' },
  { phase: 'P1', desc: '扩展段：公共地基 + 追问深度' },
  { phase: 'P2', desc: '区分度段：按目标岗位权重排' },
  { phase: '—', desc: '横向素材：未分阶段' },
];

/** 状态徽章文本 → 稳定 key（与 STATUS_COUNTS 的判定规则一致：取 emoji 前缀） */
function statusKey(status: CourseMeta['status']): string {
  if (status.startsWith('✅')) return 'done';
  if (status.startsWith('🔄') || status.startsWith('🚧')) return 'doing';
  if (status.startsWith('⏳')) return 'planned';
  return 'other';
}

// 筛选 chip 的状态维度：从 COURSES 实际出现的状态派生（不手抄，避免与数据漂移）
const STATUS_FILTERS = (() => {
  const seen = new Map<string, string>();
  for (const c of COURSES) seen.set(statusKey(c.status), c.status);
  return [...seen.entries()].map(([key, label]) => ({ key, label }));
})();
---

<Base title="学习路线">
  <h1 class="page-title">学习路线</h1>
  <p class="page-lead">
    总进度：<strong>{CARD_COUNT} 张课程卡</strong> · {DOMAIN_COUNT} 知识域 ·
    ✅ 完成 {done} / 🔄 讲义已展开 {doing} / ⏳ 规划 {planned}
    （状态实时取自 <code>src/data/courses.ts</code> 派生量）
  </p>
  <p class="page-lead">
    P0 / P1 / P2 三段 × 知识域。卡片数据来自手写映射 <code>src/data/courses.ts</code>
    （基线：notes/knowledge-map.md 课程总表）；点开进课程页。
    <br />
    <span style="color: var(--text-soft); font-size: 0.94rem">
      计数口径：{CARD_COUNT} 张课程卡 = courses.ts 全部条目（含 <code>whiteboard</code> 白板卡，
      无独立课程页、链向 /works/#whiteboard，故比 {COURSE_COUNT} 个课程页多 1）；
      {DOMAIN_COUNT} 知识域 = 14 编号课 + Harness 架构主线，不含 LLM 时间线 / 行业前线调研等横向资产。
    </span>
  </p>

  <!-- ── 筛选（P-12 · W4-A）──────────────────────────────
       渐进增强：静态 HTML 里没有任何 hidden 属性 → 无 JS 时全部卡片可见；
       筛选条本身由 CSS 默认隐藏，脚本就绪后才显示（否则会给读者一堆按了没反应的按钮）。
       维度：阶段（隐藏整个 phase-section）+ 状态（隐藏单张卡片）。 -->
  <div class="learn-filters" data-learn-filters>
    <div class="lf-group" role="group" aria-label="按阶段筛选">
      <span class="lf-label">阶段</span>
      <button type="button" class="chip lf-chip is-on" data-lf-phase="">全部</button>
      {PHASES.map(({ phase }) => (
        <button type="button" class="chip lf-chip" data-lf-phase={phase}>
          {phase === '—' ? '未分阶段' : phase}
        </button>
      ))}
    </div>
    <div class="lf-group" role="group" aria-label="按状态筛选">
      <span class="lf-label">状态</span>
      <button type="button" class="chip lf-chip is-on" data-lf-status="">全部</button>
      {STATUS_FILTERS.map(({ key, label }) => (
        <button type="button" class="chip lf-chip" data-lf-status={key}>{label}</button>
      ))}
    </div>
    <span class="lf-count" data-lf-count aria-live="polite"></span>
  </div>

  {
    PHASES.map(({ phase, desc }) => {
      const list = COURSES.filter((c) => c.phase === phase);
      return (
        <section class="phase-section" data-lf-section data-phase={phase}>
          <div class="phase-head">
            <h2>{phase === '—' ? '未分阶段' : phase}</h2>
            <span class="phase-desc">{desc}</span>
          </div>
          <div class="cards">
            {
              list.map((c) => {
                const exists = slugSet.has(c.slug);
                const isWhiteboard = c.slug === 'whiteboard';
                return isWhiteboard ? (
                  <a class="card domain-card" href={import.meta.env.BASE_URL + "works/#whiteboard"} data-lf-card data-status={statusKey(c.status)}>
                    <div class="dc-top">
                      <h3>{c.domain}</h3>
                      <StatusBadge status={c.status} />
                    </div>
                    <p class="dc-intro">{c.intro}</p>
                    {c.interviewAngle && <p class="dc-angle"><strong>面试视角</strong>：{c.interviewAngle}</p>}
                    <p class="dc-foot">作品详解 →</p>
                  </a>
                ) : exists ? (
                  <a class="card domain-card" href={import.meta.env.BASE_URL + `c/${c.slug}/`} data-lf-card data-status={statusKey(c.status)}>
                    <div class="dc-top">
                      <h3>{c.domain}</h3>
                      <StatusBadge status={c.status} />
                    </div>
                    <p class="dc-intro">{c.intro}</p>
                    {c.interviewAngle && <p class="dc-angle"><strong>面试视角</strong>：{c.interviewAngle}</p>}
                    <p class="dc-foot">进入课程 →</p>
                  </a>
                ) : (
                  <div class="card domain-card soon" aria-label="撰写中" data-lf-card data-status={statusKey(c.status)}>
                    <div class="dc-top">
                      <h3>{c.domain}</h3>
                      <StatusBadge status={c.status} />
                    </div>
                    <p class="dc-intro">{c.intro}</p>
                    {c.interviewAngle && <p class="dc-angle"><strong>面试视角</strong>：{c.interviewAngle}</p>}
                    <p class="dc-foot">撰写中（文件未就位）</p>
                  </div>
                );
              })
            }
          </div>
          <p class="lf-empty" data-lf-empty hidden>该阶段没有符合当前状态的卡片。</p>
        </section>
      );
    })
  }

  <section class="phase-section">
    <div class="phase-head">
      <h2>建议开课顺序</h2>
    </div>
    <div class="card" style="display: block">
      <p style="margin-top: 0">
        <code>系统设计</code> → <code>沙箱与凭据（续 S2）</code> → <code>评测工程化</code> →
        <code>durable execution</code> → <code>MCP 与供应链安全</code> → <code>API 与多模型路由</code> →
        <code>数据飞轮</code> →（P2 四课按目标岗位权重排）
      </p>
      <p style="color: var(--text-soft); font-size: 0.92rem">
        理由:系统设计把「从零写 harness / RAG 与检索」收口成“设计能力”;沙箱与凭据讲义已展开且 demo 已落地;评测工程化是 P1 三课(durable execution / MCP 与供应链安全 / 数据飞轮)的公共地基。
      </p>
      <p style="font-size: 0.9rem">
        完整依赖图与横切知识点见 <a href={import.meta.env.BASE_URL + "map/"}>知识地图 →</a>
      </p>
    </div>
  </section>
</Base>

{/* 筛选逻辑（vanilla JS，无第三方库）。
    无 JS 时：静态 HTML 无任何 hidden → 18 张卡片全部可见，筛选条被 CSS 藏住。
    有 JS 时：脚本先摘掉隐藏再绑定，chip 点击改 hidden 属性（不碰内联 style）。 */}
<script>
  const bar = document.querySelector<HTMLDivElement>('[data-learn-filters]');
  if (bar) {
    bar.setAttribute('data-ready', '');
    const sections = [...document.querySelectorAll<HTMLElement>('[data-lf-section]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-lf-card]')];
    const count = bar.querySelector<HTMLElement>('[data-lf-count]');
    const phaseChips = [...bar.querySelectorAll<HTMLButtonElement>('[data-lf-phase]')];
    const statusChips = [...bar.querySelectorAll<HTMLButtonElement>('[data-lf-status]')];

    let phase = '';
    let status = '';

    function apply() {
      let shown = 0;
      for (const sec of sections) {
        const phaseOk = !phase || sec.dataset.phase === phase;
        let secShown = 0;
        for (const card of cards.filter((c) => c.closest('[data-lf-section]') === sec)) {
          const statusOk = !status || card.dataset.status === status;
          const show = phaseOk && statusOk;
          card.hidden = !show;
          if (show) secShown += 1;
        }
        sec.hidden = !phaseOk || secShown === 0;
        const empty = sec.querySelector<HTMLElement>('[data-lf-empty]');
        if (empty) empty.hidden = sec.hidden || secShown > 0;
        shown += secShown;
      }
      if (count) count.textContent = `显示 ${shown} / ${cards.length} 张`;
    }

    function bind(chips: HTMLButtonElement[], set: (v: string) => void) {
      for (const chip of chips) {
        chip.addEventListener('click', () => {
          set(chip.dataset.lfPhase ?? chip.dataset.lfStatus ?? '');
          for (const c of chips) c.classList.toggle('is-on', c === chip);
          apply();
        });
      }
    }
    bind(phaseChips, (v) => (phase = v));
    bind(statusChips, (v) => (status = v));
    apply();
  }
</script>
