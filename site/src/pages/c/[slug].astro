---
/**
 * 课程页：notes/*.md 原样渲染（KaTeX + mermaid 由站点管线处理）。
 * 顶部元信息条（域/阶段/状态，来自 src/data/courses.ts）+ 侧栏 TOC。
 * 排除项（knowledge-map / interview-bank）各有独立页面（/map、/interview）。
 */
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCollection, render } from 'astro:content';
import { courseMeta, EXCLUDED_FROM_COURSE_ROUTE } from '../../data/courses';
import { extractToc } from '../../utils/toc';

export async function getStaticPaths() {
  const entries = await getCollection('courses');
  return entries
    .filter((e) => !EXCLUDED_FROM_COURSE_ROUTE.has(e.id))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const meta = courseMeta(entry.id);
const toc = extractToc(entry.body ?? '');

// 相关面试题锚点：构建期从 notes/interview-bank.md 的 TOC 按 anchorPrefix 解析出真实 heading id
// （与 interview.astro 的 idOf 同机制、同 slug 算法）——题库标题一变锚点随动；
// 前缀解析不到即构建失败（fail-fast），不再线上静默失效。
// 题库文件整体缺失时（与 /interview 的 GROUPS 同样处理）不渲染相关题区。
const bankEntry = (await getCollection('courses')).find((e) => e.id === 'interview-bank');
const bankToc = bankEntry ? extractToc(bankEntry.body ?? '') : [];
function bankAnchor(prefix: string): string {
  const hit = bankToc.find((t) => t.text.startsWith(prefix));
  if (!hit) {
    throw new Error(`c/[slug]：面试题锚点找不到小节 "${prefix}"——notes/interview-bank.md 章节变动后需同步 courses.ts 的 anchorPrefix`);
  }
  return hit.id;
}
const relatedQuestions = bankEntry
  ? meta.relatedQuestions.map((q) => ({ ...q, anchor: bankAnchor(q.anchorPrefix) }))
  : [];
---

<Base title={meta.domain}>
  <div class="course-layout">
    <article class="markdown">
      <header class="course-meta-bar">
        <div class="meta-row">
          <span class="chip chip-strong">{meta.domain}</span>
          <span class="chip">notes/{entry.id}.md</span>
          <span class="chip">{meta.phase === '—' ? '未分阶段' : meta.phase}</span>
          <StatusBadge status={meta.status} />
        </div>
        <nav class="crumbs" aria-label="面包屑">
          <a href={import.meta.env.BASE_URL + ""}>首页</a> / <a href={import.meta.env.BASE_URL + "learn/"}>学习路线</a> / <span>{meta.domain}</span>
        </nav>
      </header>

      <Content />

      {
        /* 无 JS 兜底：本页含 mermaid 图时提示读者——客户端渲染脚本不执行，图中显示的是图表源码。
           提示只能由服务端产出（noscript 内容在无脚本时才渲染，客户端代码那时并不运行）。 */
        (entry.body ?? '').includes('```mermaid') && (
          <noscript>
            <p class="mermaid-noscript">本页图表需要 JavaScript 才能渲染；未启用脚本时，图中显示的是图表源码。</p>
          </noscript>
        )
      }

      {
        relatedQuestions.length > 0 && (
          <section class="related-questions" aria-label="相关面试题">
            <h3>相关面试题</h3>
            <p class="rq-note">
              选自 <a href={import.meta.env.BASE_URL + "interview/"}>面试题库</a>（题号 = 题库内编号，链接锚到对应小节）——追问到底 = 合格线。
            </p>
            <ul class="rq-list">
              {
                relatedQuestions.map((q) => (
                  <li>
                    <a href={`${import.meta.env.BASE_URL}interview/#${encodeURIComponent(q.anchor)}`}>
                      <span class="rq-no">{q.no}</span>
                      {q.text}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
        )
      }

      <footer class="page-foot">
        <a href={import.meta.env.BASE_URL + "map/"}>知识地图</a>
        <a href={import.meta.env.BASE_URL + "interview/"}>面试题库</a>
        <a href={import.meta.env.BASE_URL + "works/"}>作品详解</a>
        <a href={import.meta.env.BASE_URL + "learn/"}>学习路线</a>
      </footer>
    </article>

    {
      toc.length > 0 && (
        <aside class="toc" aria-label="本页目录">
          <details open>
            <summary>本页目录</summary>
            <ul>
              {
                toc.map((t) => (
                  <li class={t.depth === 3 ? 'toc-3' : 'toc-2'}>
                    <a href={`#${t.id}`}>{t.text}</a>
                  </li>
                ))
              }
            </ul>
          </details>
        </aside>
      )
    }
  </div>
</Base>
