---
/**
 * 课程页：notes/*.md 原样渲染（KaTeX + mermaid 由站点管线处理）。
 * 顶部元信息条（域/阶段/状态）+「学习路径」模块（course-structure.ts）+ 侧栏 TOC。
 * 排除项（knowledge-map）另有独立页面（/map）。
 */
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCollection, render } from 'astro:content';
import { courseMeta, EXCLUDED_FROM_COURSE_ROUTE } from '../../data/courses';
import { courseBySlug, orderOf, prevCourse, nextCourse } from '../../data/course-structure';
import { mvpBySlug } from '../../data/mvps';

export async function getStaticPaths() {
  const entries = await getCollection('courses');
  return entries
    .filter((e) => !EXCLUDED_FROM_COURSE_ROUTE.has(e.id))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const meta = courseMeta(entry.id);
// TOC 锚点直接取 render() 的 headings（2026-10-19 复审改）：此前用 utils/toc.ts 的
// 自带 slugify 复刻 github-slugger，三处偏差（①–⑫ 属 \p{N} 被保留而 slugger 删除、
// 折叠连字符、`_`→`-`）导致 87/385 条目录点了不跳转——rag.md 13/15、
// harness-from-scratch.md 10/12 全中。id 由渲染同一条 remark 管线产出，从根上同源。
const toc = (headings ?? [])
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ id: h.slug, text: h.text, depth: h.depth as 2 | 3 }));

// 学习路径（course-structure.ts §3 线性序）：课程在结构表中缺失时 structure=undefined，
// 模块与五阶段阶段标签优雅降级（不渲染/回退 courses.ts phase），不报错。
const structure = courseBySlug(entry.id);
const mvp = structure ? mvpBySlug(structure.mvpSlug) : null;
// 上下篇（§8.1：线性序 index = order-1 / order+1；不用 next 字段重算序列）
const order = orderOf(entry.id);
const prev = prevCourse(entry.id);
const next = nextCourse(entry.id);

// 延伸分水岭（2026-10-19 新增）：从 details 集合的 `related` frontmatter **反查**引用本课的
// 详解页——修复「details ↔ 课程双向断链」（此前本地映射是纯文本、课程页无任何反向链接）。
// 单一真源 = notes/details/*.md 的 related 字段；slug 不存在的条目静默过滤（容错手写错）。
const relatedDetails = (await getCollection('details'))
  .filter((d) => (d.data.related ?? []).includes(entry.id))
  .map((d) => ({ slug: d.data.slug ?? d.id, title: d.data.title ?? d.id }));

// 阶段标签（2026-10-19 复审提取为单一表达式）：structure 缺失时回退 courses.ts 的
// phase，'—' 显示「未分阶段」——与下方 meta-bar 的 chip 同源，避免两份漂移。
// ⚠️ 首轮给 Base description 直接写了 structure.stage（无守卫）：若哪天新增了笔记却
// 忘了加 course-structure 条目，构建会在 description 这一行先炸（TypeError），
// 而本文件 27-28 行的注释明明写了「structure 可能 undefined」。已按同一表达式收敛。
const stageLabel = structure ? structure.stage : meta.phase === '—' ? '未分阶段' : meta.phase;

---

<Base title={meta.domain} description={`${meta.domain}（${stageLabel}）：${meta.intro}——前置知识、独占参考样本与增量主线挂钩见学习路径卡。`}>
  <div class="course-layout">
    <article class="markdown">
      <header class="course-meta-bar">
        <div class="meta-row">
          <span class="chip chip-strong">{meta.domain}</span>
          <span class="chip">notes/{entry.id}.md</span>
          <span class="chip">{stageLabel}</span>
          <StatusBadge status={meta.status} />
        </div>
        <nav class="crumbs" aria-label="面包屑">
          <a href={import.meta.env.BASE_URL + ""}>首页</a> / <a href={import.meta.env.BASE_URL + "learn/"}>学习路线</a> / <span>{meta.domain}</span>
        </nav>
      </header>

      {
        structure && mvp && (
          <section class="learning-path" aria-label="学习路径">
            <h2 class="lp-h">学习路径</h2>
            <dl class="lp-grid">
              <div class="lp-item">
                <dt>前置知识</dt>
                <dd>
                  {structure.prereqs.length > 0 ? (
                    <ul class="lp-links">
                      {structure.prereqs.map((slug) => {
                        const p = courseBySlug(slug);
                        return (
                          <li><a href={import.meta.env.BASE_URL + 'c/' + slug + '/'}>{p ? p.domain : slug}</a></li>
                        );
                      })}
                    </ul>
                  ) : (
                    <span class="lp-none">无硬前置</span>
                  )}
                  {structure.prerequisiteNote && structure.prerequisiteNote !== '—' && (
                    <p class="lp-note">技能储备：{structure.prerequisiteNote}</p>
                  )}
                </dd>
              </div>
              <div class="lp-item">
                <dt>核心概念 / 教学重点</dt>
                <dd>{structure.teachingFocus}</dd>
              </div>
              <div class="lp-item">
                <dt>实际输出</dt>
                <dd>
                  {structure.practicalOutput}
                  <p class="lp-mvp">
                    <span class="chip chip-strong">参考样本</span>
                    <code>{structure.mvpSlug}</code>
                    <span class="lp-mvp-status">{mvp.statusLabel}</span>
                  </p>
                </dd>
              </div>
              <div class="lp-item">
                <dt>后续课程</dt>
                <dd>
                  {structure.next.length > 0 ? (
                    <ul class="lp-links">
                      {structure.next.map((slug) => {
                        const n = courseBySlug(slug);
                        return (
                          <li><a href={import.meta.env.BASE_URL + 'c/' + slug + '/'}>{n ? n.domain : slug}</a></li>
                        );
                      })}
                    </ul>
                  ) : (
                    <span class="lp-none">末课 · 无后续</span>
                  )}
                </dd>
              </div>
              <div class="lp-item">
                <dt>主线挂钩</dt>
                <dd>{structure.capstoneHook ?? '无主线挂钩'}</dd>
              </div>
            </dl>
          </section>
        )
      }

      {
        /* 延伸分水岭（details 反查）：本课机制在资深分水岭里的行业对照。 */
        relatedDetails.length > 0 && (
          <section class="related-details" aria-label="延伸分水岭">
            <h2 class="rd-title">延伸分水岭</h2>
            <div class="dc-top">
              {relatedDetails.map((d) => (
                <a class="chip" href={import.meta.env.BASE_URL + 'details/' + d.slug + '/'}>{d.title}</a>
              ))}
            </div>
          </section>
        )
      }

      <Content />

      {
        /* 无 JS 兜底：本页含 mermaid 图时提示读者——客户端渲染脚本不执行，图中显示的是图表源码。
           提示只能由服务端产出（noscript 内容在无脚本时才渲染，客户端代码那时并不运行）。 */
        (entry.body ?? '').includes('```mermaid') && (
          <noscript>
            <p class="mermaid-noscript">本页图表需要 JavaScript 才能渲染；未启用脚本时，图中显示的是图表源码。</p>
          </noscript>
        )
      }


      <footer class="page-foot">
        {
          /* P-08 上下篇：左侧（margin-right:auto 推开右侧站内链接）。
             §8.1：顺序 = course-structure.ts 的线性序 index（order-1 / order+1）。
             结构表中缺失的笔记 order=-1，不渲染上下篇（不 404）。 */
          order >= 0 && (
            <nav class="prev-next" aria-label="课程上下篇">
              {prev ? (
                <a class="pn-link pn-prev" rel="prev" href={import.meta.env.BASE_URL + 'c/' + prev.slug + '/'}>
                  <span class="pn-dir">← 上一篇</span>
                  <span class="pn-title">{prev.domain}</span>
                </a>
              ) : (
                <span class="pn-link pn-prev pn-disabled" aria-disabled="true">
                  <span class="pn-dir">← 上一篇</span>
                  <span class="pn-title">已是第一篇</span>
                </span>
              )}
              {next ? (
                <a class="pn-link pn-next" rel="next" href={import.meta.env.BASE_URL + 'c/' + next.slug + '/'}>
                  <span class="pn-dir">下一篇 →</span>
                  <span class="pn-title">{next.domain}</span>
                </a>
              ) : (
                <span class="pn-link pn-next pn-disabled" aria-disabled="true">
                  <span class="pn-dir">下一篇 →</span>
                  <span class="pn-title">已是最后一篇</span>
                </span>
              )}
            </nav>
          )
        }
        <div class="foot-links">
          <a href={import.meta.env.BASE_URL + "map/"}>知识地图</a>
          <a href={import.meta.env.BASE_URL + "works/"}>作品详解</a>
          <a href={import.meta.env.BASE_URL + "learn/"}>学习路线</a>
        </div>
      </footer>
    </article>

    {
      toc.length > 0 && (
        <aside class="toc" aria-label="本页目录">
          {/* 2026-10-19：去掉硬编码 open。≤900px 时 .toc 失去 max-height 限制又常开，
              20+ 条目录整块铺在正文上方，把正文首屏推走（/c/rag/、/map/ 尤明显）。
              改由脚本按视口决定：桌面展开、窄屏收起；无 JS 时默认收起（内容仍可达）。 */}
          <details data-toc-details>
            <summary>本页目录</summary>
            <ul>
              {
                toc.map((t) => (
                  <li class={t.depth === 3 ? 'toc-3' : 'toc-2'}>
                    <a href={`#${t.id}`}>{t.text}</a>
                  </li>
                ))
              }
            </ul>
          </details>
        </aside>
      )
    }
  </div>
</Base>

<script>
  // TOC 渐进展开（2026-10-19）：桌面（≥901px，与 global.css 的 .toc sticky 断点一致）
  // 展开目录，窄屏默认收起——修复旧版 <details open> 在移动端把正文推出首屏的问题。
  // 无 JS 时保持收起（内容仍可通过 summary 展开），属可接受降级。
  const mq = window.matchMedia('(min-width: 901px)');
  const sync = () => {
    for (const d of document.querySelectorAll<HTMLDetailsElement>('details[data-toc-details]')) {
      d.open = mq.matches;
    }
  };
  sync();
  mq.addEventListener('change', sync);
</script>

<style>
  /* 学习路径模块：图卡式四象限（前置 / 教学重点 / 实际输出 / 后续）。
     位于 course-meta-bar 之后、正文之前；与 TOC / 上下篇 / 相关题共存。 */
  .learning-path {
    border: 1px solid var(--border);
    background: var(--bg-card);
    border-radius: 14px;
    padding: 16px 18px;
    margin: 0 0 24px;
    box-shadow: var(--shadow);
  }
  .learning-path .lp-h {
    margin: 0 0 12px;
    padding-bottom: 8px;
    font-size: 1.05rem;
    border-bottom: 1px solid var(--border);
  }
  .lp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px 20px;
    margin: 0;
  }
  .lp-item dt {
    font-weight: 600;
    color: var(--text-soft);
    font-size: 0.8rem;
    margin: 0 0 4px;
  }
  .lp-item dd {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .lp-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lp-links li {
    margin: 2px 0;
  }
  .lp-none {
    color: var(--text-faint);
  }
  .lp-note {
    margin: 4px 0 0;
    color: var(--text-faint);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .lp-mvp {
    margin: 8px 0 0;
    display: flex;
    align-items: center;
    gap: 6px 8px;
    flex-wrap: wrap;
  }
  .lp-mvp code {
    font-size: 0.82rem;
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0 5px;
  }
  .lp-mvp-status {
    color: var(--text-faint);
    font-size: 0.82rem;
  }
</style>