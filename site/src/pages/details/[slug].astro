---
/**
 * /details/[slug]：notes/details/*.md 原样渲染。
 * frontmatter 约定：title / slug / domain / source / status（可缺省，兜底用文件名）。
 * 路由 slug 优先用 frontmatter 的 slug 字段。
 */
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCollection, render } from 'astro:content';
import { courseBySlug } from '../../data/course-structure';

export async function getStaticPaths() {
  const items = await getCollection('details');
  return items.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = entry.data.title ?? entry.id;
const KIND_LABEL: Record<string, string> = {
  'mechanism-deepdive': '机制深挖',
  'design-detail': '设计细节',
  'cost-detail': '成本细节',
};
const kind = KIND_LABEL[entry.data.kind as string] ? (entry.data.kind as string) : undefined;

/** 来源 URL → 可读域名（meta 条里放完整 URL 会在窄屏撑破布局：实测 375px 溢出 197px）。 */
const sourceUrl = entry.data.source as string | undefined;
const sourceHost = (() => {
  if (!sourceUrl) return undefined;
  try {
    return new URL(sourceUrl).host.replace(/^www\./, '');
  } catch {
    return sourceUrl;
  }
})();

/** 相关课程（2026-10-19 新增）：frontmatter `related` 列的课程 slug → 域名。
 *  与 c/[slug].astro 的「延伸分水岭」反查格共用同一真源（related 字段），构成双向链接。 */
const relatedCourses = (() => {
  const slugs = entry.data.related ?? [];
  return slugs
    .map((slug) => {
      const s = courseBySlug(slug);
      return s ? { slug: s.slug, domain: s.domain } : null;
    })
    .filter((c): c is { slug: string; domain: string } => c !== null);
})();
---

<Base title={title} description={`${entry.data.domain ?? '资深分水岭'}：${title}${kind ? `（${KIND_LABEL[kind]}）` : ''}——行业一手源 + 课程本地映射（已覆盖 / 未覆盖）。`}>
  <article class="markdown">
    <header class="course-meta-bar">
      <div class="meta-row">
        <span class="chip chip-strong">详解</span>
        {kind && <span class={`chip kind-${kind}`}>{KIND_LABEL[kind]}</span>}
        {entry.data.domain && <span class="chip">{entry.data.domain}</span>}
        {sourceUrl && (
          <a class="chip chip-src" href={sourceUrl} target="_blank" rel="noopener" title={sourceUrl}>
            来源：{sourceHost} ↗
          </a>
        )}
        {entry.data.status && <StatusBadge status={entry.data.status} />}
      </div>
      <nav class="crumbs" aria-label="面包屑">
        <a href={import.meta.env.BASE_URL + ""}>首页</a> / <a href={import.meta.env.BASE_URL + "details/"}>详解</a> / <span>{title}</span>
      </nav>
    </header>

    {
      /* 相关课程（2026-10-19 新增）：由本页 frontmatter 的 related 字段派生——
         修复「本地映射纯文本、无法点回课程」的断链。slug 不在课程集合的静默过滤。 */
      relatedCourses.length > 0 && (
        <section class="related-courses" aria-label="相关课程">
          <h2 class="rd-title">相关课程</h2>
          <div class="dc-top">
            {relatedCourses.map((c) => (
              <a class="chip" href={import.meta.env.BASE_URL + 'c/' + c.slug + '/'}>{c.domain}</a>
            ))}
          </div>
        </section>
      )
    }

    <Content />

    <footer class="page-foot">
      <a href={import.meta.env.BASE_URL + "details/"}>详解列表</a>
      <a href={import.meta.env.BASE_URL + "learn/"}>学习路线</a>
    </footer>
  </article>
</Base>

<style>
  /* 来源 chip：域名形态通常很短，仍加换行保护，避免极端长域名撑破窄屏 */
  .chip-src {
    max-width: 100%;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .chip-src:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
