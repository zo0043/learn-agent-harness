---
/**
 * /details 列表页：notes/details/*.md（frontmatter 带 title/slug/domain/source/status/kind）。
 * 目录可能为空（并行 worker 正在新增）→ 显示空态。
 * kind：mechanism-deepdive 机制深挖 / design-detail 设计细节 / cost-detail 成本细节。
 */
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('details');

const KIND_LABEL: Record<string, string> = {
  'mechanism-deepdive': '机制深挖',
  'design-detail': '设计细节',
  'cost-detail': '成本细节',
};
const kindOf = (item: (typeof items)[number]) =>
  KIND_LABEL[item.data.kind as string] ? (item.data.kind as string) : undefined;

/** 最该先读的 top3（context-rot / tool-granularity / harness-rot） */
const TOP3_SLUGS = ['01-context-rot', '02-tool-granularity', '07-harness-rot'];
const top3Set = new Set(TOP3_SLUGS);
const top3 = TOP3_SLUGS.map(
  (slug) => items.find((i) => (i.data.slug ?? i.id) === slug),
).filter((i): i is (typeof items)[number] => Boolean(i));

/** 其余详解 = 全部条目去掉 top3 三篇（top3 已在上方单列，避免同页双渲染） */
const rest = items.filter((i) => !top3Set.has(i.data.slug ?? i.id));

/** 来源 URL → 可读域名（与 /details/[slug] 同款：meta 条放完整 URL 会在窄屏撑破布局，
 *  实测 375px 溢出 197px；完整 URL 留 title 属性，悬停可见）。 */
const sourceHost = (url: string | undefined) => {
  if (!url) return undefined;
  try {
    return new URL(url).host.replace(/^www\./, '');
  } catch {
    return url;
  }
};

/** 取正文“## 一句话定义”下第一段作为卡片摘要 */
function oneLiner(body: string | undefined): string {
  if (!body) return '';
  const lines = body.split('\n');
  const start = lines.findIndex((l) => l.trim() === '## 一句话定义');
  if (start === -1) return '';
  for (let j = start + 1; j < lines.length; j++) {
    const t = lines[j].trim();
    if (!t) continue;
    if (t.startsWith('#')) return '';
    return t.replace(/[*_`]/g, '');
  }
  return '';
}
---

<Base title="详解" description={`${items.length} 个资深分水岭详解：每篇带行业一手源与课程本地映射（哪些课已覆盖 / 哪些没覆盖），讲到机制层时可直接查用。`}>
  <h1 class="page-title">详解</h1>
  <p class="page-lead">
    课程之外的延伸详解：<strong>{items.length} 个资深分水岭</strong>——每篇带行业一手源 + 本地映射
    （哪些课已覆盖 / 哪些没覆盖），讲到机制层时可直接查用。
  </p>

  <!-- ── 全景索引：先给「这些分水岭分别属于哪个领域」──────
       读者来本页的第一诉求是「资深分水岭有哪些、我需要补哪个」，
       故按领域铺成一张紧凑索引表，再往下才是正文卡片。 -->
  <section class="dx-index">
    <h2 class="dx-index-title">{items.length} 个分水岭一览</h2>
    <ul class="dx-list">
      {
        items.map((item) => {
          const kind = kindOf(item);
          const slug = item.data.slug ?? item.id;
          return (
            <li class="dx-row">
              <a class="dx-row-link" href={import.meta.env.BASE_URL + `details/${slug}/`}>
                <span class="dx-domain">{item.data.domain ?? '—'}</span>
                <span class="dx-title">{item.data.title ?? slug}</span>
                <span class="dx-meta">
                  {kind && <span class={`chip kind-${kind}`}>{KIND_LABEL[kind]}</span>}
                  {top3Set.has(slug) && <span class="chip chip-strong">最该先读</span>}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  {
    top3.length > 0 && (
      <section class="details-top3">
        <h2 class="page-title section-gap">最该先读的三篇</h2>
        <div class="cards">
          {
            top3.map((item) => {
              const kind = kindOf(item);
              return (
                <a class="card" href={import.meta.env.BASE_URL + `details/${item.data.slug ?? item.id}/`}>
                  <h3>{item.data.title ?? item.id}</h3>
                  <div class="dc-top">
                    {kind && <span class={`chip kind-${kind}`}>{KIND_LABEL[kind]}</span>}
                    {item.data.domain && <span class="chip">{item.data.domain}</span>}
                  </div>
                  {oneLiner(item.body) && <p class="dc-intro">{oneLiner(item.body)}</p>}
                </a>
              );
            })
          }
        </div>
      </section>
    )
  }

  <h2 class="page-title section-gap">其余 {rest.length} 篇</h2>
  {
    rest.length > 0 ? (
      <div class="cards">
        {
          rest.map((item) => {
            const kind = kindOf(item);
            return (
              <a class="card" href={import.meta.env.BASE_URL + `details/${item.data.slug ?? item.id}/`}>
                <h3>{item.data.title ?? item.id}</h3>
                <div class="dc-top">
                  {kind && <span class={`chip kind-${kind}`}>{KIND_LABEL[kind]}</span>}
                  {item.data.domain && <span class="chip">{item.data.domain}</span>}
                  {item.data.source && <span class="chip" title={item.data.source}>来源：{sourceHost(item.data.source)}</span>}
                </div>
                {oneLiner(item.body) && <p class="dc-intro">{oneLiner(item.body)}</p>}
                {item.data.status && <StatusBadge status={item.data.status} />}
              </a>
            );
          })
        }
      </div>
    ) : (
      <div class="empty-state">
        <p class="empty-icon">📂</p>
        <p>
          <strong>详解目录还是空的</strong> ——
          <code>notes/details/</code> 尚未有文件（并行内容 worker 正在新增）。
          文件入仓后，本页随下一次构建自动列出。
        </p>
      </div>
    )
  }
</Base>

<style>
  /* U-36 收敛：本页标题间距内联样式提为页面级类（视觉零变化）。 */
  .section-gap { margin-top: 34px; }

  /* 全景索引：8 行紧凑列表（领域 + 标题 + 标签），比卡片墙更快扫完 */
  .dx-index {
    margin-top: 20px;
  }
  .dx-index-title {
    font-size: 1rem;
    margin: 0 0 8px;
    color: var(--text-soft);
    font-weight: 600;
  }
  .dx-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-card);
  }
  .dx-row + .dx-row {
    border-top: 1px solid var(--border);
  }
  .dx-row-link {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 9px 14px;
    text-decoration: none;
    color: inherit;
  }
  .dx-row-link:hover {
    background: var(--bg-soft);
  }
  .dx-domain {
    font-size: 0.82rem;
    color: var(--text-soft);
  }
  .dx-title {
    font-size: 0.92rem;
    font-weight: 500;
  }
  .dx-meta {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  @media (max-width: 640px) {
    .dx-row-link {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .dx-domain {
      font-weight: 600;
    }
  }
</style>
