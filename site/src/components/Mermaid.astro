---
/**
 * 手写 mermaid 图（如 /map 依赖图）。
 * 源码放进 <div class="mermaid">，由 src/scripts/mermaid.ts 在客户端渲染；
 * 源码文本会被 Astro 自动转义，客户端读 textContent 拿回原文。
 */
interface Props {
  chart: string;
  title?: string;
}
const { chart, title } = Astro.props;
---

<figure class="mermaid-figure">
  <div class="mermaid">{chart}</div>
  {
    title && (
      <figcaption>{title}</figcaption>
    )
  }
</figure>
