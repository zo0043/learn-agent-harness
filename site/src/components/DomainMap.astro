---
import { statusKey } from '../utils/status';

/**
 * DomainMap：/map 顶部的交互式知识域视图（P-05 知识地图交互化）。
 *
 * 五档迁移（t36）：阶段单一真源 = course-structure.ts 的 STAGES / STAGE_LABELS / stage 字段，
 * 与 /learn/ 同口径（同一 stage 标签），替换旧 courses.ts 三档 phase（P0/P1/P2）及其 PHASE_DESC 文案。
 * 卡片状态/导读仍取自 courses.ts（courseMeta）；
 * 域集合 = COURSE_STRUCTURE 排除横向资产（isHorizontal）后按 domain 去重——
 * 白板卡本就不在 COURSE_STRUCTURE，无需单独排除。
 * 构建期断言派生集合与 DOMAIN_COUNT 严格相等，防漂移。
 *
 * 交互形态（契约约束）：
 *   - 纯 HTML/CSS：阶段分组 + 页内锚点导航（无 JS 可用），
 *     触屏设备（hover: none）常显——不引第三方库、不写一行 JS，禁用 JS 的访客内容完整可见；
 *   - 不做 mermaid 节点事件绑定：securityLevel:'strict' 下绑定被禁（W3-C 已核实 strict 并不
 *     禁用 htmlLabels，但节点事件绑定在 strict 下确实无效），依赖关系继续由笔记内 mermaid
 *     依赖图承担，避免与安全级别决策耦合；也不手绘连线、不从笔记 mermaid 解析边表。
 */
import { DOMAIN_COUNT, courseMeta } from '../data/courses';
import { STAGES, STAGE_LABELS, COURSE_STRUCTURE } from '../data/course-structure';

interface DomainCard {
  slug: string;
  domain: string;
  stage: string;
  status: string;
  intro: string;
}

// 域集合：course-structure.ts 阶段单一真源 + courses.ts 状态/导读联合视图；
// 排除横向资产（isHorizontal）：llm-timeline / industry-2026 不是「知识域」，不计入 15。
const domains: DomainCard[] = COURSE_STRUCTURE.filter((c) => !c.isHorizontal).map((c) => {
  const meta = courseMeta(c.slug);
  return {
    slug: c.slug,
    domain: meta.domain,
    stage: c.stage,
    status: meta.status,
    intro: meta.intro,
  };
});

// 构建期一致性断言：派生集合必须与冻结口径（DOMAIN_COUNT）严格相等
if (domains.length !== DOMAIN_COUNT || new Set(domains.map((d) => d.domain)).size !== DOMAIN_COUNT) {
  throw new Error(
    `DomainMap：派生域集合（${domains.length} 条 / ${new Set(domains.map((d) => d.domain)).size} 个去重 domain）` +
      `与 DOMAIN_COUNT（${DOMAIN_COUNT}）不一致——courses.ts / course-structure.ts 过滤口径变动后需同步本组件`,
  );
}

const groups = STAGES.map((stage) => ({
  stage,
  label: STAGE_LABELS[stage],
  cards: domains.filter((d) => d.stage === stage),
}));

/** 状态 → legend 三色（与笔记 mermaid classDef 同色：done #2ea043 / doing #bb8009 / todo #6e7681）。
 *  判定规则单一真源 = utils/status.ts（StatusBadge / learn.astro 共用；2026-10-19 前三处口径不一）。 */
function statusDot(status: string): { cls: string; label: string } {
  const key = statusKey(status);
  const cls = key === 'done' ? 'ok' : key === 'doing' ? 'doing' : 'todo';
  return { cls, label: status.replace(/^(✅|🔄|🚧|⏳)\s*/, '') };
}

const base = import.meta.env.BASE_URL;
---

<section class="dm-zone" aria-label="知识域视图">
  <h2 class="dm-title">知识域总览</h2>
  <p class="dm-lead">
    {domains.length} 个知识域（口径见 <code>notes/knowledge-map.md</code> 头部冻结块），
    阶段与 <code>course-structure.ts</code> 五档同源、与「学习路线」同口径——不会漂移。
  </p>

  <div class="legend">
    <span><span class="legend-dot ok"></span>已完成</span>
    <span><span class="legend-dot doing"></span>进行中 / 讲义已展开</span>
    <span><span class="legend-dot todo"></span>规划中</span>
  </div>

  <nav class="dm-nav" aria-label="按阶段跳转">
    {groups.map((g) => (
      <a class="chip" href={`#dm-${g.stage}`}>{g.stage} · {g.cards.length} 域</a>
    ))}
  </nav>

  {
    groups.map((g) => (
      <div class="phase-section dm-group" id={`dm-${g.stage}`}>
        <div class="phase-head">
          <h3>{g.stage} · {g.label}</h3>
          <span class="phase-desc">{g.cards.length} 域</span>
        </div>
        <div class="cards">
          {g.cards.map((d) => {
            const dot = statusDot(d.status);
            return (
              <a class="card domain-card dm-card" href={base + `c/${d.slug}/`}>
                <div class="dc-top">
                  <h3>{d.domain}</h3>
                  <span class="dm-status">
                    <span class={`legend-dot ${dot.cls}`}></span>
                    {dot.label}
                  </span>
                  <span class="chip">{d.stage}</span>
                </div>
                <p class="dc-intro">{d.intro}</p>
                <p class="dc-foot">进入课程 →</p>
              </a>
            );
          })}
        </div>
      </div>
    ))
  }
</section>