---
import SiteSearch from './SiteSearch.astro';
import { COURSE_STRUCTURE } from '../data/course-structure';

const base = import.meta.env.BASE_URL;
const nav = [
  { href: '/', label: '首页', start: true },
  // 横向知识导航页（LLM 发展史与演进 + 五阶段课程地图）：序章横向资产（llm-timeline
  // 在线性序 #1、不计入 15 知识域），故排在首页之后。
  // 2026-10-19 更正：旧注释写「按方案位于 P0 之前」——与 course-structure.ts 的
  // stage:'P0'（llm-timeline 在 P0 内）及 learn.astro 的「横向知识不挂阶段」三处矛盾。
  { href: '/nav/', label: '导航' },
  { href: '/learn/', label: '学习路线' },
  { href: '/details/', label: '详解' },
  { href: '/works/', label: '作品' },
  { href: '/map/', label: '知识地图' },
  // W3-A：/timeline 路由已删（内容与 /c/llm-timeline 100% 重复且是残缺版：无 TOC / 无 page-foot）。
  // 入口不破——导航改链课程页版本，那里有 meta-bar + TOC + page-foot。
  { href: '/c/llm-timeline/', label: '时间线' },
];
const rawPath = Astro.url.pathname;
const path = rawPath.startsWith(base) ? rawPath.slice(base.length - 1) : rawPath;

// 横向资产（isHorizontal）不是 17 课线性主线：它们有独立入口（时间线）或只作收口素材。
// 「学习路线」的 /c/ 兜底高亮必须排除这些横向页，否则 /c/llm-timeline/ 会与「时间线」双高亮。
const HORIZONTAL_SLUGS = new Set(
  COURSE_STRUCTURE.filter((c) => c.isHorizontal).map((c) => c.slug),
);

function courseSlugFrom(pathname: string): string {
  const m = pathname.match(/^\/c\/([^/]+)/);
  return m ? m[1] : '';
}

function isActive(item: (typeof nav)[number]): boolean {
  if (item.start) return path === '/' || path === '/index.html';
  if (path.startsWith(item.href.replace(/\/$/, ''))) return true;
  // /c/<slug>/ 课程页归属「学习路线」：否则全站 17 个课程页在导航上完全失联，
  // 而面包屑写的又是「首页 / 学习路线 / 域名」，两套定位信号互相矛盾。
  // 但横向页（llm-timeline / industry-2026）除外——它们不是线性主线课，应走自己的入口/不兜底。
  if (item.href === '/learn/' && path.startsWith('/c/')) {
    return !HORIZONTAL_SLUGS.has(courseSlugFrom(path));
  }
  return false;
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={import.meta.env.BASE_URL + ""}>learn<span class="brand-accent">-agent</span>-harness</a>
    <nav class="site-nav" id="site-nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={base + item.href.replace(/^\//, '')}
            class={`${item.featured ? 'featured ' : ''}${isActive(item) ? 'active' : ''}`}
            aria-current={isActive(item) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    {/* P-07：≤720px 八个导航项 + 主题按钮 + 搜索入口同行挤压——收进汉堡浮层。
        桌面（≥721px）按钮隐藏、导航原样横排；浮层内 Tab 循环、Esc/点外部关闭。 */}
    <button
      class="nav-toggle"
      data-nav-toggle
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="打开导航菜单"
      title="导航菜单"
    >
      <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
    </button>
    <SiteSearch />
    <button
      class="theme-toggle"
      data-theme-toggle
      type="button"
      aria-label="切换明暗主题"
      title="切换明暗主题"
    >
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </button>
  </div>
</header>

<script>
  /**
   * 焦点陷阱（P-07）：浮层内 Tab / Shift+Tab 循环。抽成纯函数便于 node 等效验证
   * （见交付说明的抽取测试）；activeIndex = -1 表示焦点不在浮层内（如汉堡按钮上），
   * 落首项（Tab）/ 末项（Shift+Tab）。
   */
  export function nextFocusIndex(count: number, activeIndex: number, shift: boolean): number {
    if (count <= 0) return -1;
    if (activeIndex < 0) return shift ? count - 1 : 0;
    if (shift) return activeIndex <= 0 ? count - 1 : activeIndex - 1;
    return activeIndex >= count - 1 ? 0 : activeIndex + 1;
  }

  function initNavToggle(): void {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = document.querySelector<HTMLElement>('#site-nav');
    if (!toggle || !panel) return;
    const links = () => Array.from(panel.querySelectorAll<HTMLAnchorElement>('a[href]'));

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
      panel.classList.toggle('open', open);
      if (open) links()[0]?.focus();
    };
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // 焦点陷阱补口：浮层展开时焦点在汉堡按钮上按 Tab 会溜进右侧搜索/主题按钮，
    // 这里把按钮也纳入循环（activeIndex=-1 → 首/末项，与浮层内同一纯函数）。
    toggle.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !isOpen()) return;
      const items = links();
      const next = nextFocusIndex(items.length, -1, e.shiftKey);
      if (next >= 0) {
        e.preventDefault();
        items[next]?.focus();
      }
    });

    // Esc 关闭并把焦点还给按钮（键盘用户不丢焦点）
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // 焦点陷阱：Tab 在浮层内循环（仅浮层展开时生效）
    panel.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !isOpen()) return;
      const items = links();
      const activeIndex = items.indexOf(document.activeElement as HTMLAnchorElement);
      const next = nextFocusIndex(items.length, activeIndex, e.shiftKey);
      if (next >= 0) {
        e.preventDefault();
        items[next]?.focus();
      }
    });

    // 点浮层外部关闭（pointerdown 早于 click，避免与链接点击竞争）
    document.addEventListener('pointerdown', (e) => {
      if (!isOpen()) return;
      const t = e.target as Node | null;
      if (t && !panel.contains(t) && !toggle.contains(t)) setOpen(false);
    });

    // 视口拉宽到桌面宽度时清理移动态（否则汉堡隐藏而浮层仍开着）
    const mq = window.matchMedia('(min-width: 721px)');
    mq.addEventListener('change', (e) => {
      if (e.matches && isOpen()) setOpen(false);
    });
  }

  initNavToggle();
</script>
